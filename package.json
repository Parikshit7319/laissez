{
  "name": "laissez",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "esbuild scripts/test-engine.ts --bundle --platform=node --format=esm --outfile=.astro/test-engine.mjs --log-level=warning && node .astro/test-engine.mjs",
    "test:api": "node api/test/smoke.mjs",
    "test:rules": "esbuild scripts/test-rulepacks.ts --bundle --platform=node --format=esm --outfile=.astro/test-rules.mjs --log-level=warning && node .astro/test-rules.mjs",
    "test:openapi": "esbuild scripts/test-openapi.ts --bundle --platform=node --format=esm --outfile=.astro/test-openapi.mjs --log-level=warning --packages=external && node .astro/test-openapi.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.3",
    "astro": "^5.18.2",
    "d3-geo": "^3.1.1",
    "preact": "^10.29.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "esbuild": "^0.25.12"
  }
}

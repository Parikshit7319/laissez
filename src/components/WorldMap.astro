---
// Build-time dotted world map with distribution corridors. Each corridor links to the matching
// scenario in the guided demo (demo/#scenario=investor:fund:action), which the Console reads on load.
import { feature } from 'topojson-client';
import { geoNaturalEarth1, geoContains } from 'd3-geo';
import land110 from 'world-atlas/land-110m.json';
import { url } from '../lib/url';

const W = 1400, H = 640;
const topo: any = land110;
const land: any = feature(topo, topo.objects.land);
const proj = geoNaturalEarth1().fitExtent([[0, -40], [W, H + 150]], { type: 'Sphere' } as any);

const step = 8.5;
let dots = '';
let row = 0;
for (let y = step / 2; y < H; y += step * 0.866, row++) {
  for (let x = (row % 2 ? step / 2 : 0) + step / 2; x < W; x += step) {
    const ll = proj.invert!([x, y]);
    if (!ll || ll[1] < -56 || ll[1] > 78) continue;
    if (geoContains(land, ll)) dots += `M${x.toFixed(1)} ${y.toFixed(1)}h0`;
  }
}

type City = { id: string; name: string; ll: [number, number]; label?: 'l' | 'r' | 't' | 'b' };
const cities: City[] = [
  { id: 'nyc', name: 'New York', ll: [-74.0, 40.71], label: 'l' },
  { id: 'bvi', name: 'Tortola', ll: [-64.62, 18.42], label: 'b' },
  { id: 'dub', name: 'Dublin', ll: [-6.26, 53.35], label: 'l' },
  { id: 'lux', name: 'Luxembourg', ll: [6.13, 49.61] },
  { id: 'zrh', name: 'Zurich', ll: [8.54, 47.37], label: 'b' },
  { id: 'fra', name: 'Frankfurt', ll: [8.68, 50.11] },
  { id: 'dxb', name: 'Dubai', ll: [55.27, 25.2], label: 'b' },
  { id: 'sg', name: 'Singapore', ll: [103.82, 1.35], label: 'b' },
  { id: 'hk', name: 'Hong Kong', ll: [114.17, 22.32], label: 'r' },
];
const notes: Record<string, [string, string]> = {
  nyc: ['New York, SEC', 'Accredited investors (Reg D 501(a)) and qualified purchasers (ICA 2(a)(51)). Delaware LP domicile for private credit.'],
  bvi: ['Tortola, BVI FSC', 'Fund domicile for professional funds sold under Regulation S to non-US investors.'],
  dub: ['Dublin, Central Bank of Ireland', 'Fund domicile for ICAVs and UCITS. EU professional clients meet 2 of 3 size tests under MiFID II.'],
  lux: ['Luxembourg, CSSF', 'Fund domicile for SICAVs and RAIFs. The AIFMD passport reaches professional investors across the EU.'],
  zrh: ['Zurich, FINMA', 'Swiss professional clients under FinSA: 2 of 3 of CHF 20M balance sheet, CHF 40M turnover, CHF 2M equity.'],
  fra: ['Frankfurt, BaFin', 'EU retail clients need a PRIIPs key information document. Professional clients meet 2 of 3 size tests.'],
  dxb: ['Dubai, DFSA', 'DIFC professional clients: individuals with US$1M net assets and relevant experience (COB 2.3).'],
  sg: ['Singapore, MAS', 'Accredited investors who opt in: S$2M net personal assets, S$1M net financial assets or S$300K income (SFA s4A).'],
  hk: ['Hong Kong, SFC', 'Professional investors: a HK$8M portfolio for individuals, HK$40M total assets for corporations (Cap. 571D).'],
};
const P = Object.fromEntries(cities.map((c) => [c.id, proj(c.ll)!]));
// Corridors run from the fund domicile to the investor. Each carries the demo scenario it opens.
type Route = { from: string; to: string; scenario: string; title: string; outcome: 'ok' | 'no' };
const routes: Route[] = [
  { from: 'bvi', to: 'sg', scenario: 'lumen:TWLF:subscribe', title: 'Lumen Family Office subscribes to Tidewell Treasury Liquidity', outcome: 'ok' },
  { from: 'dub', to: 'hk', scenario: 'meitan:NMEL:subscribe', title: 'Mei Tan subscribes to Northmere Euro Liquidity', outcome: 'ok' },
  { from: 'nyc', to: 'dxb', scenario: 'qamar:AGPC:transfer', title: 'Qamar Holdings transfers Ashgrove Private Credit interests', outcome: 'no' },
  { from: 'bvi', to: 'zrh', scenario: 'sorell:TWLF:subscribe', title: 'Sorell Pensionskasse subscribes to Tidewell Treasury Liquidity', outcome: 'ok' },
  { from: 'dub', to: 'fra', scenario: 'kestrel:NMEL:subscribe', title: 'Kestrel Treasury subscribes to Northmere Euro Liquidity', outcome: 'ok' },
  { from: 'dub', to: 'sg', scenario: 'lumen:NMEL:subscribe', title: 'Lumen Family Office subscribes to Northmere Euro Liquidity', outcome: 'ok' },
  { from: 'bvi', to: 'hk', scenario: 'meitan:TWLF:subscribe', title: 'Mei Tan subscribes to Tidewell Treasury Liquidity', outcome: 'ok' },
  { from: 'nyc', to: 'zrh', scenario: 'sorell:AGPC:subscribe', title: 'Sorell Pensionskasse subscribes to Ashgrove Private Credit', outcome: 'ok' },
];
const arcs = routes.map((r, i) => {
  const [x1, y1] = P[r.from], [x2, y2] = P[r.to];
  const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
  const dist = Math.hypot(x2 - x1, y2 - y1);
  const lift = Math.min(dist * 0.32, 190);
  return { ...r, d: `M${x1.toFixed(1)} ${y1.toFixed(1)} Q${mx.toFixed(1)} ${(my - lift).toFixed(1)} ${x2.toFixed(1)} ${y2.toFixed(1)}`, i, pair: `${r.from} ${r.to}` };
});
// Crop to Europe, the Gulf and Asia; corridors from the Americas enter from the left edge.
const X0 = proj([-28, 0])![0], X1 = proj([150, 0])![0];
const Y0 = Math.max(0, proj([20, 70])![1]), Y1 = proj([105, -14])![1];
const CW = X1 - X0, CH = Y1 - Y0;
const pct = (id: string) => ({ left: `${((P[id][0] - X0) / CW) * 100}%`, top: `${((P[id][1] - Y0) / CH) * 100}%` });
const sg = pct('sg'), dxb = pct('dxb');
const demo = url('demo/');
---
<div class="map" style={`aspect-ratio:${CW.toFixed(0)} / ${CH.toFixed(0)}`}>
  <svg viewBox={`${X0.toFixed(1)} ${Y0.toFixed(1)} ${CW.toFixed(1)} ${CH.toFixed(1)}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="World map showing tokenized fund corridors between New York, Tortola, Dublin, Luxembourg, Zurich, Frankfurt, Dubai, Singapore and Hong Kong. Each corridor opens a scenario in the guided demo.">
    <path d={dots} class="land" />
    {arcs.map((a) => (
      <a href={`${demo}#scenario=${a.scenario}`} class="corridor" data-pair={a.pair} data-t={a.title} data-o={a.outcome} aria-label={`${a.title}. Open this corridor in the guided demo.`}>
        <path d={a.d} class="arc-hit" />
        <path d={a.d} class="arc-base" />
        <path d={a.d} class="arc-pulse" pathLength="100" style={`animation-delay:${(a.i * 0.9).toFixed(1)}s`} />
      </a>
    ))}
    {cities.map((c) => {
      const [x, y] = P[c.id];
      const lx = c.label === 'l' ? x - 12 : c.label === 'r' ? x + 12 : x;
      const ly = c.label === 'b' ? y + 22 : c.label === 't' ? y - 14 : y + 4;
      const anchor = c.label === 'l' ? 'end' : c.label === 'r' ? 'start' : 'middle';
      const n = notes[c.id];
      return (<g class="city" data-id={c.id} data-t={n?.[0]} data-n={n?.[1]} data-x={((x - X0) / CW * 100).toFixed(2)} data-y={((y - Y0) / CH * 100).toFixed(2)}>
        <circle cx={x} cy={y} r="18" class="hit" />
        <circle cx={x} cy={y} r="3.4" class="node" />
        <circle cx={x} cy={y} r="3.4" class="ring" />
        {c.label ? <text x={lx} y={ly} text-anchor={anchor}>{c.name}</text> : null}
      </g>);
    })}
  </svg>
  <div class="map-tip" hidden><strong></strong><span></span><em></em></div>
  <a class="map-card ok" style={`left:${sg.left};top:${sg.top}`} href={`${demo}#scenario=lumen:TWLF:subscribe`}>
    <span class="mc-k">TWLF subscription</span>
    <strong>Lumen Family Office</strong>
    <span class="mc-l">Singapore resident, booked in Hong Kong</span>
    <span class="mc-row"><span class="pill ok">Admitted</span><span>2 binding rules, 8 checks</span></span>
    <span class="mc-l">Settled atomically against USDC</span>
  </a>
  <a class="map-card no" style={`left:${dxb.left};top:${dxb.top}`} href={`${demo}#scenario=qamar:AGPC:transfer`}>
    <span class="mc-k">AGPC transfer</span>
    <strong>Refused before settlement</strong>
    <span class="mc-l">12-month lock-up ends 1 Jun 2027</span>
    <span class="mc-row"><span class="pill no">Refused</span><span>Nothing moved</span></span>
  </a>
</div>

<script>
  for (const map of document.querySelectorAll<HTMLElement>('.map')) {
    const tip = map.querySelector<HTMLElement>('.map-tip')!;
    const [tT, tN, tE] = [tip.querySelector('strong')!, tip.querySelector('span')!, tip.querySelector('em')!];
    const corridors = [...map.querySelectorAll<SVGAElement>('.corridor')];
    const show = (t: string, n: string, e: string, x: string, y: string) => {
      tT.textContent = t; tN.textContent = n; tE.textContent = e;
      tip.style.left = x + '%'; tip.style.top = y + '%'; tip.hidden = false;
    };
    const hide = () => { map.classList.remove('hovering'); corridors.forEach((a) => a.classList.remove('hot')); map.querySelectorAll('.city.hot').forEach((g) => g.classList.remove('hot')); tip.hidden = true; };
    for (const g of map.querySelectorAll<SVGGElement>('.city[data-t]')) {
      const on = () => {
        const id = g.dataset.id!;
        map.classList.add('hovering');
        g.classList.add('hot');
        corridors.forEach((a) => a.classList.toggle('hot', a.dataset.pair!.split(' ').includes(id)));
        show(g.dataset.t!, g.dataset.n!, '', g.dataset.x!, g.dataset.y!);
      };
      g.addEventListener('pointerenter', on);
      g.addEventListener('pointerleave', hide);
    }
    for (const a of corridors) {
      const on = (e: Event) => {
        map.classList.add('hovering');
        corridors.forEach((c) => c.classList.toggle('hot', c === a));
        const [from, to] = a.dataset.pair!.split(' ');
        const city = (id: string) => map.querySelector<SVGGElement>(`.city[data-id="${id}"]`)!;
        city(from).classList.add('hot'); city(to).classList.add('hot');
        const tc = city(to);
        const x = (parseFloat(city(from).dataset.x!) + parseFloat(tc.dataset.x!)) / 2;
        const y = Math.min(parseFloat(city(from).dataset.y!), parseFloat(tc.dataset.y!)) - 4;
        show(a.dataset.t!, a.dataset.o === 'ok' ? 'Admitted in the demo. Every rule passes and both legs settle.' : 'Refused in the demo. The lock-up has not ended, so nothing moves.', 'Click to open this corridor in the guided demo', String(x), String(Math.max(6, y)));
        void e;
      };
      a.addEventListener('pointerenter', on);
      a.addEventListener('focus', on);
      a.addEventListener('pointerleave', hide);
      a.addEventListener('blur', hide);
    }
  }
</script>

<style>
  .map { position: relative; width: 100%; max-width: 100%; }
  .map svg { width: 100%; height: 100%; overflow: hidden; }
  .land { stroke: #bdb7aa; stroke-width: 2.6; stroke-linecap: round; fill: none; }
  .hit { fill: transparent; cursor: help; }
  .corridor { cursor: pointer; outline: none; }
  .arc-hit { fill: none; stroke: transparent; stroke-width: 14; }
  .arc-base { fill: none; stroke: rgba(15, 92, 74, 0.28); stroke-width: 1.1; transition: stroke 200ms, opacity 200ms, stroke-width 200ms; }
  .arc-pulse { fill: none; stroke: #0f5c4a; stroke-width: 1.8; stroke-linecap: round; stroke-dasharray: 9 100; stroke-dashoffset: 109; opacity: 0.9; animation: travel 7.2s linear infinite; }
  @keyframes travel { from { stroke-dashoffset: 109; } to { stroke-dashoffset: 0; } }
  .map.hovering .arc-base { opacity: 0.35; }
  .map.hovering .corridor.hot .arc-base { opacity: 1; stroke: #0f5c4a; stroke-width: 2; }
  .map.hovering .corridor:not(.hot) .arc-pulse { opacity: 0.2; }
  .corridor:focus-visible .arc-base { stroke: #0f5c4a; stroke-width: 2.4; opacity: 1; }
  .map.hovering .map-card { opacity: 0.35; }
  .map-card { transition: opacity 200ms; }
  .node { fill: #14161a; }
  .ring { fill: none; stroke: #0f5c4a; stroke-width: 1.2; transform-box: fill-box; transform-origin: center; animation: ping 3.6s ease-out infinite; }
  .city:nth-of-type(2n) .ring { animation-delay: 1.2s; }
  .city:nth-of-type(3n) .ring { animation-delay: 2.1s; }
  @keyframes ping { 0% { transform: scale(1); opacity: 0.8; } 70%, 100% { transform: scale(4); opacity: 0; } }
  .city text { font: 500 13px var(--f-ui); fill: #4a4f57; }
  .city.hot text { fill: #14161a; font-weight: 600; }
  .city.hot .node { fill: #0f5c4a; }
  .map-tip {
    position: absolute; z-index: 3; transform: translate(-50%, calc(-100% - 1rem)); width: 17rem; pointer-events: none;
    display: grid; gap: 0.25rem; background: #14161a; color: #d9d6cf; border-radius: 8px; padding: 0.7rem 0.85rem;
    box-shadow: 0 16px 36px -16px rgba(20, 22, 26, 0.5); font-size: 0.78rem; line-height: 1.45;
  }
  .map-tip[hidden] { display: none; }
  .map-tip strong { font-size: 0.84rem; font-weight: 600; color: #fff; }
  .map-tip em { font-style: normal; color: #a8d8c6; font-size: 0.74rem; }
  .map-tip em:empty { display: none; }
  .map-card {
    position: absolute; transform: translate(-50%, 1.6rem); display: grid; gap: 0.15rem; width: 14.5rem; text-decoration: none;
    background: rgba(255, 255, 255, 0.94); border: 1px solid var(--line); border-radius: 10px; padding: 0.8rem 0.95rem;
    box-shadow: var(--shadow); font-size: 0.78rem; line-height: 1.4; color: var(--ink-2);
  }
  .map-card:hover { border-color: var(--line-2); }
  .map-card.no { transform: translate(-96%, 2.2rem); }
  .map-card.ok { transform: translate(-58%, 2rem); }
  .map-card strong { color: var(--ink); font-weight: 600; font-size: 0.92rem; }
  .mc-k { color: var(--ink-3); font-size: 0.74rem; }
  .mc-row { display: flex; align-items: center; gap: 0.5rem; margin: 0.25rem 0 0.1rem; }
  .pill { font-weight: 650; font-size: 0.72rem; padding: 0.15rem 0.5rem; border-radius: 999px; }
  .pill.ok { color: var(--white); background: var(--green); }
  .pill.no { color: var(--white); background: var(--coral); }
  @media (max-width: 760px) {
    .map-card { position: static; transform: none !important; margin-top: 0.75rem; width: auto; }
    .map { aspect-ratio: auto !important; }
    .map svg { height: auto; }
    .map-tip { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .arc-pulse { animation: none; stroke-dasharray: none; opacity: 0.35; } .ring { animation: none; opacity: 0; } }
</style>

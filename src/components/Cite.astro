---
import { sourceIndex, getSource } from '../data/sources';
import { url } from '../lib/url';
interface Props { id: string | string[] }
const ids = Array.isArray(Astro.props.id) ? Astro.props.id : [Astro.props.id];
for (const id of ids) { if (!sourceIndex[id]) throw new Error(`Unknown source id: ${id}`); }
---
{ids.map((id, i) => {
  const s = getSource(id)!;
  return <a class="cite" href={url(`sources/#${id}`)} title={`${s.publisher}: ${s.title} (${s.date})`} aria-label={`Source ${sourceIndex[id]}: ${s.publisher}`}>{i > 0 ? ',' : ''}{sourceIndex[id]}</a>;
})}

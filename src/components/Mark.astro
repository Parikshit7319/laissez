---
// Two jurisdictions overlapping; the shared lens is where Laissez works.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="mark">
  <defs>
    <clipPath id="mk-a"><circle cx="12" cy="16" r="9.5" /></clipPath>
    <linearGradient id="mk-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e6d2a4" /><stop offset="1" stop-color="#c9a96e" /></linearGradient>
  </defs>
  <circle cx="20" cy="16" r="9.5" fill="url(#mk-g)" clip-path="url(#mk-a)" />
  <circle cx="12" cy="16" r="9.5" fill="none" stroke="currentColor" stroke-width="1.4" />
  <circle cx="20" cy="16" r="9.5" fill="none" stroke="currentColor" stroke-width="1.4" />
</svg>

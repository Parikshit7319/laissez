---
// Two jurisdictions overlapping; the shared lens is where Laissez works.
interface Props { size?: number }
const { size = 26 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="mark">
  <defs>
    <clipPath id="mk-a"><circle cx="12" cy="16" r="9.5" /></clipPath>
  </defs>
  <circle cx="20" cy="16" r="9.5" fill="#0f5c4a" clip-path="url(#mk-a)" />
  <circle cx="12" cy="16" r="9.5" fill="none" stroke="currentColor" stroke-width="1.5" />
  <circle cx="20" cy="16" r="9.5" fill="none" stroke="currentColor" stroke-width="1.5" />
</svg>

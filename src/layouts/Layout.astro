---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { url } from '../lib/url';

interface Props { title: string; description: string; path: string }
const { title, description, path } = Astro.props;
const fullTitle = path === '' ? 'Laissez' : `${title} | Laissez`;
const canonical = new URL(url(path), Astro.site).toString();
const here = (p: string) => path.replace(/\/$/, '') === p.replace(/\/$/, '');
const inSolutions = path.startsWith('solutions');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Laissez" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#0d0c0b" />
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..600,0..100,0..1;1,9..144,300..600,0..100,0..1&family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap head-row">
      <a class="brand" href={url('')} aria-label="Laissez home"><Mark size={26} /><span>Laissez</span></a>
      <nav class="site-nav" id="site-nav" aria-label="Primary">
        <ul>
          <li><a href={url('product/')} aria-current={here('product/') ? 'page' : undefined}>Product</a></li>
          <li class="has-menu">
            <button type="button" class="menu-trigger" aria-expanded="false" aria-controls="sol-menu" data-current={inSolutions ? 'true' : undefined}>Solutions
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="menu" id="sol-menu">
              <a href={url('solutions/distributors/')}><strong>For distributors</strong><span>Sell funds from any issuer to clients in any jurisdiction.</span></a>
              <a href={url('solutions/issuers/')}><strong>For issuers</strong><span>Reach verified investors across borders without new onboarding.</span></a>
            </div>
          </li>
          <li><a href={url('developers/')} aria-current={here('developers/') ? 'page' : undefined}>Developers</a></li>
          <li><a href={url('trust/')} aria-current={here('trust/') ? 'page' : undefined}>Trust</a></li>
          <li><a href={url('pricing/')} aria-current={here('pricing/') ? 'page' : undefined}>Pricing</a></li>
          <li><a href={url('company/')} aria-current={here('company/') ? 'page' : undefined}>Company</a></li>
        </ul>
        <div class="head-cta">
          <a class="btn ghost-sm" href={url('app/')}>Open sandbox</a>
          <a class="btn brass sm" href={url('access/')}>Request access</a>
        </div>
      </nav>
      <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu"><span></span><span></span></button>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-top">
        <div class="foot-brand">
          <a class="brand" href={url('')}><Mark size={24} /><span>Laissez</span></a>
          <p>The compliance and settlement layer for tokenized funds crossing borders. In private development, onboarding design partners.</p>
        </div>
        <div class="foot-cols">
          <div><h4>Product</h4><ul><li><a href={url('product/')}>Overview</a></li><li><a href={url('product/#credential')}>Eligibility credential</a></li><li><a href={url('product/#resolver')}>Policy resolver</a></li><li><a href={url('product/#settlement')}>Atomic settlement</a></li><li><a href={url('demo/')}>Guided demo</a></li><li><a href={url('app/')}>Open sandbox</a></li></ul></div>
          <div><h4>Solutions</h4><ul><li><a href={url('solutions/distributors/')}>For distributors</a></li><li><a href={url('solutions/issuers/')}>For issuers</a></li><li><a href={url('pricing/')}>Pricing</a></li></ul></div>
          <div><h4>Developers</h4><ul><li><a href={url('developers/')}>API overview</a></li><li><a href={url('developers/#decisions')}>Decisions API</a></li><li><a href={url('developers/#webhooks')}>Webhooks</a></li></ul></div>
          <div><h4>Company</h4><ul><li><a href={url('company/')}>About</a></li><li><a href={url('trust/')}>Trust and security</a></li><li><a href={url('sources/')}>Data sources</a></li><li><a href={url('access/')}>Request access</a></li></ul></div>
        </div>
      </div>
      <div class="foot-base">
        <p>© 2026 Laissez. Founded by Parikshit Ambhore in Houston, Texas.</p>
        <p>Laissez is pre-launch software. Nothing on this site is an offer of securities or a regulated service. Institutions and data in the demo are fictional. Market figures are sourced and dated.</p>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var trig = document.querySelector('.menu-trigger');
      var menu = document.getElementById('sol-menu');
      if (trig && menu) {
        trig.addEventListener('click', function (e) {
          e.stopPropagation();
          trig.setAttribute('aria-expanded', trig.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
        });
        document.addEventListener('click', function (e) { if (!menu.contains(e.target)) trig.setAttribute('aria-expanded', 'false'); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') trig.setAttribute('aria-expanded', 'false'); });
      }
      var burger = document.querySelector('.burger');
      var nav = document.getElementById('site-nav');
      burger.addEventListener('click', function () {
        var open = burger.getAttribute('aria-expanded') === 'true';
        burger.setAttribute('aria-expanded', open ? 'false' : 'true');
        nav.classList.toggle('open', !open);
        document.body.classList.toggle('nav-open', !open);
      });
      var head = document.querySelector('.site-head');
      var onScroll = function () { head.classList.toggle('scrolled', window.scrollY > 8); };
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</body>
</html>

<style is:global>
  .site-head { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 100; transition: background 200ms ease, border-color 200ms ease; border-bottom: 1px solid transparent; }
  .site-head.scrolled { background: rgba(13, 12, 11, 0.84); backdrop-filter: blur(14px) saturate(1.3); -webkit-backdrop-filter: blur(14px) saturate(1.3); border-bottom-color: var(--hair); }
  .head-row { display: flex; align-items: center; gap: 2rem; height: 4.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--text); font-family: var(--f-display); font-size: 1.45rem; font-weight: 400; letter-spacing: -0.01em; font-variation-settings: 'SOFT' 0, 'WONK' 0; }
  .site-nav { display: flex; align-items: center; flex: 1; gap: 1.5rem; }
  .site-nav ul { display: flex; align-items: center; gap: 0.15rem; list-style: none; margin: 0 auto 0 1rem; padding: 0; }
  .site-nav ul a, .menu-trigger { font: 450 0.92rem/1 var(--f-ui); color: var(--text-2); text-decoration: none; padding: 0.6rem 0.75rem; border-radius: 999px; background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem; }
  .site-nav ul a:hover, .menu-trigger:hover, .menu-trigger[aria-expanded='true'] { color: var(--text); background: rgba(255, 255, 255, 0.05); }
  .site-nav ul a[aria-current='page'], .menu-trigger[data-current] { color: var(--text); }
  .has-menu { position: relative; }
  .menu { position: absolute; top: calc(100% + 0.6rem); left: -0.5rem; width: 22rem; background: var(--night-2); border: 1px solid var(--hair-2); border-radius: 14px; padding: 0.5rem; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6); display: none; }
  .menu-trigger[aria-expanded='true'] + .menu { display: grid; }
  .site-nav .menu a { display: grid; gap: 0.25rem; padding: 0.85rem 1rem; border-radius: 10px; line-height: 1.4; }
  .menu a strong { color: var(--text); font-weight: 550; }
  .menu a span { color: var(--text-3); font-size: 0.84rem; }
  .head-cta { display: flex; gap: 0.5rem; }
  .btn.sm, .btn.ghost-sm { padding: 0.65rem 1.05rem; font-size: 0.875rem; }
  .burger { display: none; margin-left: auto; width: 2.6rem; height: 2.6rem; border-radius: 999px; border: 1px solid var(--hair-2); background: none; position: relative; cursor: pointer; }
  .burger span { position: absolute; left: 0.8rem; right: 0.8rem; height: 1.5px; background: var(--text); transition: transform 200ms; }
  .burger span:first-child { top: 1.05rem; } .burger span:last-child { top: 1.45rem; }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(0.2rem) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-0.2rem) rotate(-45deg); }
  @media (max-width: 1080px) {
    .burger { display: block; }
    .site-nav { display: none; position: fixed; inset: 4.5rem 0 0 0; background: var(--night); flex-direction: column; align-items: stretch; padding: 1.5rem var(--gutter) 2rem; overflow-y: auto; }
    .site-nav.open { display: flex; }
    .site-nav ul { flex-direction: column; align-items: stretch; margin: 0; gap: 0; }
    .site-nav ul a, .menu-trigger { font-size: 1.2rem; padding: 1rem 0; border-radius: 0; border-bottom: 1px solid var(--hair); width: 100%; justify-content: space-between; }
    .site-nav ul a:hover, .menu-trigger:hover { background: none; }
    .menu, .menu-trigger + .menu { position: static; width: auto; display: grid; background: none; border: 0; box-shadow: none; padding: 0 0 0.5rem; }
    .site-nav .menu a { border-bottom: 0; padding: 0.6rem 0; }
    .head-cta { flex-direction: column; margin-top: 1.5rem; }
    .head-cta .btn { padding: 1rem; font-size: 1rem; }
    body.nav-open { overflow: hidden; }
  }
  .site-foot { background: #090807; border-top: 1px solid var(--hair); padding: 4.5rem 0 3rem; color: var(--text-2); font-size: 0.92rem; }
  .foot-top { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 3rem; }
  .foot-brand p { margin-top: 1rem; max-width: 22rem; line-height: 1.6; color: var(--text-3); }
  .foot-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .foot-cols h4 { color: var(--text); font-size: 0.875rem; margin-bottom: 1rem; }
  .foot-cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .foot-cols a { color: var(--text-3); text-decoration: none; }
  .foot-cols a:hover { color: var(--brass-2); }
  .foot-base { margin-top: 4rem; padding-top: 1.75rem; border-top: 1px solid var(--hair); display: grid; grid-template-columns: auto 1fr; gap: 1rem 3rem; font-size: 0.8125rem; color: var(--text-3); }
  .foot-base p { margin: 0; max-width: 52rem; }
  @media (max-width: 900px) { .foot-top { grid-template-columns: 1fr; } .foot-cols { grid-template-columns: repeat(2, 1fr); } .foot-base { grid-template-columns: 1fr; } }
</style>

---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { url } from '../lib/url';

interface Props { title: string; description: string; path: string; noindex?: boolean; image?: string }
const { title, description, path, noindex = false, image = 'og.png' } = Astro.props;
const fullTitle = path === '' ? 'Laissez, compliance and settlement for tokenized funds' : `${title} | Laissez`;
const site = Astro.site ?? new URL('https://parikshit7319.github.io');
const canonical = new URL(url(path), site).toString();
const ogImage = new URL(url(image), site).toString();
const here = (p: string) => path.replace(/\/$/, '') === p.replace(/\/$/, '');
const inSolutions = path.startsWith('solutions');
const inDevelopers = path.startsWith('developers');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex ? <meta name="robots" content="noindex" /> : null}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Laissez" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Laissez: tokenized funds, cleared to cross borders" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="theme-color" content="#f7f5f0" />
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <link rel="sitemap" href={url('sitemap-index.xml')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..600,0..100,0..1;1,9..144,300..600,0..100,0..1&family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap head-row">
      <a class="brand" href={url('')} aria-label="Laissez home"><Mark size={24} /><span>Laissez</span></a>
      <nav class="site-nav" id="site-nav" aria-label="Primary">
        <ul>
          <li><a href={url('product/')} aria-current={here('product/') ? 'page' : undefined}>Product</a></li>
          <li class="has-menu">
            <button type="button" class="menu-trigger" aria-expanded="false" aria-controls="sol-menu" data-current={inSolutions ? 'true' : undefined}>Solutions
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="menu" id="sol-menu">
              <a href={url('solutions/distributors/')}><strong>For distributors</strong><span>Sell funds from any issuer to clients in any jurisdiction.</span></a>
              <a href={url('solutions/issuers/')}><strong>For issuers</strong><span>Reach verified investors across borders without new onboarding.</span></a>
            </div>
          </li>
          <li><a href={url('developers/')} aria-current={inDevelopers ? 'page' : undefined}>Developers</a></li>
          <li><a href={url('trust/')} aria-current={here('trust/') ? 'page' : undefined}>Trust</a></li>
          <li><a href={url('pricing/')} aria-current={here('pricing/') ? 'page' : undefined}>Pricing</a></li>
          <li><a href={url('company/')} aria-current={here('company/') ? 'page' : undefined}>Company</a></li>
        </ul>
        <div class="head-cta">
          <a class="head-link" href={url('demo/')}>Guided demo</a>
          <a class="btn primary sm" href={url('app/')}>Try the sandbox</a>
        </div>
      </nav>
      <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Open menu"><span></span><span></span></button>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-foot">
    <div class="wrap">
      <div class="foot-top">
        <div class="foot-brand">
          <a class="brand" href={url('')}><Mark size={22} /><span>Laissez</span></a>
          <p>The compliance and settlement layer for tokenized funds crossing borders. In private development, onboarding design partners.</p>
          <a class="btn primary sm" href={url('app/')}>Try the sandbox</a>
        </div>
        <div class="foot-cols">
          <div><h4>Product</h4><ul><li><a href={url('product/')}>Overview</a></li><li><a href={url('product/#credential')}>Eligibility credential</a></li><li><a href={url('product/#resolver')}>Policy resolver</a></li><li><a href={url('product/#settlement')}>Atomic settlement</a></li><li><a href={url('product/#network')}>Credential network</a></li><li><a href={url('demo/')}>Guided demo</a></li><li><a href={url('app/')}>Sandbox</a></li></ul></div>
          <div><h4>Solutions</h4><ul><li><a href={url('solutions/distributors/')}>For distributors</a></li><li><a href={url('solutions/issuers/')}>For issuers</a></li><li><a href={url('pricing/')}>Pricing</a></li><li><a href={url('access/')}>Request access</a></li></ul></div>
          <div><h4>Developers</h4><ul><li><a href={url('developers/')}>API overview</a></li><li><a href={url('developers/reference/')}>API reference</a></li><li><a href={url('developers/sdks/')}>SDKs</a></li><li><a href={url('developers/#decisions')}>Decisions API</a></li><li><a href={url('developers/#webhooks')}>Webhooks</a></li></ul></div>
          <div><h4>Company</h4><ul><li><a href={url('company/')}>About</a></li><li><a href={url('trust/')}>Trust and security</a></li><li><a href={url('sources/')}>Data sources</a></li><li><a href={url('privacy/')}>Privacy</a></li><li><a href={url('terms/')}>Terms</a></li></ul></div>
        </div>
      </div>
      <div class="foot-live">
        <a href={url('status/')} class="foot-status"><span class="dot" aria-hidden="true"></span>Status</a>
        <a href={url('metrics/')}>Live metrics</a>
        <a href="https://laissez-api.laissez.workers.dev/v1/openapi.json" rel="noopener">OpenAPI 3.1</a>
      </div>
      <div class="foot-base">
        <p>© 2026 Laissez. Founded by Parikshit Ambhore in Houston, Texas.</p>
        <p>Laissez is pre-launch software. Nothing on this site is an offer of securities or a regulated service. Institutions and data in the demo and sandbox are fictional. Market figures are sourced and dated.</p>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var trig = document.querySelector('.menu-trigger');
      var menu = document.getElementById('sol-menu');
      if (trig && menu) {
        trig.addEventListener('click', function (e) {
          e.stopPropagation();
          trig.setAttribute('aria-expanded', trig.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');
        });
        document.addEventListener('click', function (e) { if (!menu.contains(e.target)) trig.setAttribute('aria-expanded', 'false'); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') trig.setAttribute('aria-expanded', 'false'); });
      }
      var burger = document.querySelector('.burger');
      var nav = document.getElementById('site-nav');
      burger.addEventListener('click', function () {
        var open = burger.getAttribute('aria-expanded') === 'true';
        burger.setAttribute('aria-expanded', open ? 'false' : 'true');
        burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
        nav.classList.toggle('open', !open);
        document.body.classList.toggle('nav-open', !open);
      });
      var head = document.querySelector('.site-head');
      var onScroll = function () { head.classList.toggle('scrolled', window.scrollY > 8); };
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
      var dot = document.querySelector('.foot-status .dot');
      if (dot && 'fetch' in window) {
        fetch('https://laissez-api.laissez.workers.dev/v1/status', { mode: 'cors' }).then(function (r) { return r.ok ? r.json() : null; }).then(function (j) {
          if (!j) return;
          dot.classList.add(j.status === 'operational' ? 'ok' : 'bad');
          dot.parentNode.setAttribute('title', j.status === 'operational' ? 'All systems operational' : 'Some checks are failing');
        }).catch(function () {});
      }
    })();
  </script>
</body>
</html>

<style is:global>
  .site-head { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 100; background: rgba(247, 245, 240, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid transparent; transition: border-color 200ms ease; }
  .site-head.scrolled { border-bottom-color: var(--line); }
  .head-row { display: flex; align-items: center; gap: 1.5rem; height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; color: var(--ink); font-family: var(--f-display); font-size: 1.35rem; font-weight: 500; letter-spacing: -0.01em; font-variation-settings: 'SOFT' 0, 'WONK' 0; }
  .brand:hover { color: var(--ink); }
  .site-nav { display: flex; align-items: center; flex: 1; gap: 1rem; }
  .site-nav ul { display: flex; align-items: center; gap: 0.1rem; list-style: none; margin: 0 auto 0 0.75rem; padding: 0; }
  .site-nav ul a, .menu-trigger { font: 500 0.92rem/1 var(--f-ui); color: var(--ink-2); text-decoration: none; padding: 0.55rem 0.7rem; border-radius: 6px; background: none; border: 0; cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem; }
  .site-nav ul a:hover, .menu-trigger:hover, .menu-trigger[aria-expanded='true'] { color: var(--ink); background: var(--paper-2); }
  .site-nav ul a[aria-current='page'], .menu-trigger[data-current] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--green); border-radius: 6px 6px 0 0; }
  .has-menu { position: relative; }
  .menu { position: absolute; top: calc(100% + 0.5rem); left: -0.5rem; width: 21rem; background: var(--white); border: 1px solid var(--line); border-radius: 10px; padding: 0.4rem; box-shadow: var(--shadow); display: none; }
  .menu-trigger[aria-expanded='true'] + .menu { display: grid; }
  .site-nav .menu a { display: grid; gap: 0.2rem; padding: 0.75rem 0.9rem; border-radius: 8px; line-height: 1.4; }
  .site-nav .menu a:hover { background: var(--paper-2); }
  .menu a strong { color: var(--ink); font-weight: 560; }
  .menu a span { color: var(--ink-3); font-size: 0.84rem; }
  .head-cta { display: flex; gap: 0.75rem; align-items: center; }
  .head-link { font: 500 0.92rem/1 var(--f-ui); color: var(--ink-2); text-decoration: none; padding: 0.55rem 0.5rem; }
  .head-link:hover { color: var(--ink); }
  .burger { display: none; margin-left: auto; width: 2.6rem; height: 2.6rem; border-radius: 8px; border: 1px solid var(--line-2); background: var(--white); position: relative; cursor: pointer; }
  .burger span { position: absolute; left: 0.75rem; right: 0.75rem; height: 1.5px; background: var(--ink); transition: transform 200ms; }
  .burger span:first-child { top: 1.05rem; } .burger span:last-child { top: 1.45rem; }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(0.2rem) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-0.2rem) rotate(-45deg); }
  @media (max-width: 1000px) {
    .burger { display: block; }
    .site-nav { display: none; position: fixed; inset: 4rem 0 0 0; background: var(--paper); flex-direction: column; align-items: stretch; padding: 1rem var(--gutter) 2rem; overflow-y: auto; gap: 0; }
    .site-nav.open { display: flex; }
    .site-nav ul { flex-direction: column; align-items: stretch; margin: 0; gap: 0; }
    .site-nav ul a, .menu-trigger { font-size: 1.1rem; padding: 0.95rem 0; border-radius: 0; border-bottom: 1px solid var(--line); width: 100%; justify-content: space-between; }
    .site-nav ul a:hover, .menu-trigger:hover, .menu-trigger[aria-expanded='true'] { background: none; }
    .site-nav ul a[aria-current='page'], .menu-trigger[data-current] { box-shadow: none; color: var(--green); }
    .menu, .menu-trigger + .menu { position: static; width: auto; display: grid; background: none; border: 0; box-shadow: none; padding: 0 0 0.5rem; }
    .site-nav .menu a { border-bottom: 0; padding: 0.6rem 0; }
    .head-cta { flex-direction: column; align-items: stretch; margin-top: 1.5rem; gap: 0.5rem; }
    .head-cta .btn { padding: 1rem; font-size: 1rem; }
    .head-link { text-align: center; padding: 0.9rem; border: 1px solid var(--line-2); border-radius: 8px; background: var(--white); }
    body.nav-open { overflow: hidden; }
  }
  .site-foot { background: var(--paper-2); border-top: 1px solid var(--line); padding: 3.5rem 0 2.5rem; color: var(--ink-2); font-size: 0.92rem; }
  .foot-top { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 3rem; }
  .foot-brand p { margin: 1rem 0 1.25rem; max-width: 22rem; line-height: 1.6; color: var(--ink-2); }
  .foot-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem 1.5rem; }
  .foot-cols h4 { color: var(--ink); font-size: 0.875rem; margin-bottom: 0.9rem; }
  .foot-cols ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .foot-cols a { color: var(--ink-2); text-decoration: none; }
  .foot-cols a:hover { color: var(--green); text-decoration: underline; }
  .foot-live { margin-top: 3rem; padding-top: 1.25rem; border-top: 1px solid var(--line-2); display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; font-size: 0.875rem; }
  .foot-live a { color: var(--ink); text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; gap: 0.5rem; }
  .foot-live a:hover { color: var(--green); }
  .foot-status .dot { width: 0.55rem; height: 0.55rem; border-radius: 999px; background: var(--line-2); }
  .foot-status .dot.ok { background: var(--green); box-shadow: 0 0 0 3px var(--green-wash); }
  .foot-status .dot.bad { background: var(--coral); box-shadow: 0 0 0 3px var(--coral-wash); }
  .foot-base { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); display: grid; grid-template-columns: auto 1fr; gap: 0.75rem 3rem; font-size: 0.8125rem; color: var(--ink-3); }
  .foot-base p { margin: 0; max-width: 52rem; }
  @media (max-width: 900px) { .foot-top { grid-template-columns: 1fr; } .foot-cols { grid-template-columns: repeat(2, 1fr); } .foot-base { grid-template-columns: 1fr; } }
</style>

---
import Layout from '../layouts/Layout.astro';
import Console from '../proto/Console';
import { url, ARTIFACT } from '../lib/url';
---
<Layout title="Live demo" description="Run a cross-border order through Laissez: eligibility across four rule layers, atomic settlement and the issuer's impact preview." path="demo/">
  <section class="page-hero compact">
    <div class="wrap">
      <p class="eyebrow">Live demo</p>
      <h1>Run a cross-border order through Laissez.</h1>
      <p class="lede">You are Aster & Vale, a private bank with booking centers in Hong Kong, Singapore, Zurich, Dubai and New York. Follow the tour, then change the client, the fund or the circumstances and watch every rule respond. The thresholds and legal references are real. The institutions are fictional.</p>
    </div>
  </section>
  <section class="band tight" style="padding-top:1rem">
    <div class="wrap app demo-frame">
      <Console client:load sourcesHref={ARTIFACT ? 'sources.html#' : url('sources/#')} />
    </div>
  </section>
</Layout>
<style>
  .compact { padding-block: clamp(3rem, 6vw, 4.5rem) 1.5rem; }
  .compact h1 { font-size: clamp(2.1rem, 1.5rem + 2.2vw, 3.3rem); max-width: 22ch; }
  .compact .lede { margin-top: 1rem; font-size: 1.05rem; max-width: 52rem; }
  .compact::after { display: none; }
  .demo-frame { color: var(--ink); }
  .demo-frame :global(.console-shell) { margin: 0; }
  .demo-frame :global(.tour) { background: #f1edf8; }
  .demo-frame :global(.tour.tour-off) { background: var(--paper-sunk); }
  .demo-frame :global(.console) { box-shadow: 0 60px 120px -40px rgba(0, 0, 0, 0.7); }
</style>

---
import Layout from '../layouts/Layout.astro';
import Console from '../proto/Console';
import { url, ARTIFACT } from '../lib/url';
---
<Layout title="Guided demo" description="Run a cross-border order through Laissez: eligibility across seven rule layers, atomic settlement and the issuer's impact preview. Deterministic, in the browser, no account needed." path="demo/">
  <section class="page-hero compact">
    <div class="wrap">
      <h1>Run a cross-border order through Laissez.</h1>
      <p class="lede">You are Aster &amp; Vale, a private bank with booking centres in Hong Kong, Singapore, Zurich, Dubai and New York. Follow the tour, then change the client, the fund or the circumstances and watch every rule respond. The thresholds and legal references are real. The institutions are fictional. Everything here runs in your browser; the sandbox runs the same scenarios against the live API.</p>
      <div class="hero-cta"><a class="btn primary" href={url('app/')}>Try the sandbox</a><a class="arrow-link" href={url('developers/')}>Make the same calls from code</a></div>
    </div>
  </section>
  <section class="band tight demo-band">
    <div class="wrap app demo-frame">
      <Console client:load sourcesHref={ARTIFACT ? 'sources.html#' : url('sources/#')} appHref={ARTIFACT ? 'app.html' : url('app/')} />
    </div>
  </section>
</Layout>
<style>
  .compact { padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem; }
  .compact h1 { max-width: 22ch; }
  .compact .lede { max-width: 52rem; }
  .compact .hero-cta { margin-top: 1.5rem; }
  .demo-band { padding-top: 1.5rem; border-top: 0 !important; }
  .demo-frame { color: var(--ink); }
  .demo-frame :global(.console-shell) { margin: 0; }
</style>

---
import Layout from '../layouts/Layout.astro';
import WorldMap from '../components/WorldMap.astro';
import Cite from '../components/Cite.astro';
import { Credential } from '../proto/Credential';
import { investors, jurName as baseJurName } from '../proto/data';
import { RULE_PACKS, NEW_JURISDICTIONS } from '../proto/rulepacks';
import { url } from '../lib/url';
import '../styles/proto.css';

const API = import.meta.env.PUBLIC_API_BASE?.replace(/\/$/, '') || 'https://laissez-api.laissez.workers.dev';
const jurName: Record<string, string> = { ...baseJurName };
for (const j of NEW_JURISDICTIONS) jurName[j.code] = j.name;
// Active eligibility packs, one row per jurisdiction, newest version wins.
const active = new Map<string, { jur: string; version: string; summary: string; from: string }>();
for (const p of RULE_PACKS) {
  if (p.jurisdiction === 'GLOBAL' || p.status !== 'active') continue;
  const cur = active.get(p.jurisdiction);
  const from = p.effective_from ?? '';
  if (!cur || from > cur.from) active.set(p.jurisdiction, { jur: p.jurisdiction, version: p.version, summary: p.summary, from });
}
const drafts = RULE_PACKS.filter((p) => p.status === 'draft' && !active.has(p.jurisdiction));
const packs = [...active.values()].sort((a, b) => (jurName[a.jur] ?? a.jur).localeCompare(jurName[b.jur] ?? b.jur));
const packCount = packs.length;
const globalPacks = RULE_PACKS.filter((p) => p.jurisdiction === 'GLOBAL' && p.status === 'active');
---
<Layout title="Laissez" description="Laissez lets distributors offer tokenized funds from any issuer to investors in any jurisdiction: one credential per investor, every rule resolved before a token moves, atomic settlement." path="">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="display reveal">Tokenized funds, cleared to cross borders.</h1>
        <p class="lede reveal d1">A distributor verifies an investor once. Laissez resolves every rule that applies to each order, in every jurisdiction involved, and settles cash and fund units in one step. Issuers keep their token and their registry. Distributors keep their clients.</p>
        <div class="hero-cta reveal d2">
          <a class="btn primary" href={url('app/')}>Try the sandbox</a>
          <a class="arrow-link" href={url('demo/')}>Watch the guided demo</a>
        </div>
        <p class="fine reveal d2 hero-fine">No sign-up. A private sandbox with fictional institutions, deleted after 7 days.</p>
      </div>
      <div class="hero-map reveal d2"><WorldMap /></div>
    </div>
    <div class="wrap standards">
      <span>Built on open standards</span>
      <ul>
        <li><b>ERC-3643</b><span>permissioned tokens</span></li>
        <li><b>ONCHAINID</b><span>identity registry claims</span></li>
        <li><b>IVMS101 and TRP</b><span>Travel Rule messaging</span></li>
        <li><b>OpenID Connect</b><span>single sign-on</span></li>
        <li><b>WebAuthn</b><span>passkeys, no passwords</span></li>
        <li><b>OpenAPI 3.1</b><span>typed API and SDKs</span></li>
      </ul>
    </div>
  </section>

  <section class="band light" id="how">
    <div class="wrap">
      <div class="sec-head">
        <h2>Three steps between an order and a settled trade.</h2>
        <p class="lede">Each step is a real API call you can make in the sandbox today. Nothing is simulated except the money.</p>
      </div>
      <ol class="three">
        <li>
          <span class="n">1</span>
          <h3>Verify once</h3>
          <p>The distributor that already did KYC issues a credential. It records the investor's legal classification in each jurisdiction, with the citation, the evidence reference and an expiry. Personal data stays with the distributor.</p>
          <code>POST /v1/credentials</code>
        </li>
        <li>
          <span class="n">2</span>
          <h3>Resolve every rule</h3>
          <p>For each subscription, transfer or redemption, Laissez checks the credential, the fund's policy, the investor's home law, the booking centre's licence, documents, fund terms and global screens. The stricter rule binds, and the decision says which.</p>
          <code>POST /v1/decisions</code>
        </li>
        <li>
          <span class="n">3</span>
          <h3>Settle both legs</h3>
          <p>Fund units and the cash leg swap in one transaction, or neither moves. The decision is re-checked at the moment of settlement, signed, and only its hash goes on-chain.</p>
          <code>POST /v1/settlements</code>
        </li>
      </ol>
    </div>
  </section>

  <section class="band" id="reuse">
    <div class="wrap reuse">
      <div class="sec-head">
        <h2>One credential, every fund.</h2>
      </div>
      <div class="reuse-grid">
        <p>A client verified by one distributor is verified for every fund on the network, and for every other distributor the client chooses to share with.</p>
        <p>The credential carries a passport number, not personal data. Another distributor enters the number, the client consents by typed signature, and the classifications are read live from the distributor that issued them.</p>
        <p>Revoke on either side and the client moves to redemption-only everywhere at once. Nobody is trapped, and nobody onboards twice.</p>
      </div>
      <div class="reuse-cta"><a class="arrow-link" href={`${url('app/')}#/network`}>See the network in the app</a></div>
    </div>
  </section>

  <section class="band raised proof" id="proof">
    <div class="wrap">
      <div class="proof-head">
        <h2>Live from the sandbox API</h2>
        <p class="muted">Read from <code>GET /v1/metrics/public</code> when this page loads. Fictional money, real code paths. <a class="text-link" href={url('metrics/')}>All metrics</a></p>
      </div>
      <dl class="proof-grid" id="proof-grid" data-api={API}>
        <div><dt>Credentials reused</dt><dd data-k="reuse">...</dd><p>investors cleared for two or more funds on one credential</p></div>
        <div><dt>Cross-border settlements</dt><dd data-k="settlements">...</dd><p>orders that passed every check and settled across a border</p></div>
        <div><dt>Settled without a passing re-check</dt><dd data-k="guardrail">...</dd><p>the guardrail. The target is zero, always.</p></div>
        <div><dt>Median time to first settlement</dt><dd data-k="ttv">...</dd><p>from an empty sandbox to a settled cross-border order</p></div>
      </dl>
      <p class="fine proof-note" id="proof-note">Loading live figures.</p>
    </div>
  </section>

  <section class="band" id="screens">
    <div class="wrap">
      <div class="sec-head">
        <h2>What the people using it see.</h2>
        <p class="lede">Four screens from the product, drawn from the same data the sandbox runs on. Open any of them for real with the button above.</p>
      </div>
      <div class="screens">
        <figure class="screen">
          <div class="frame">
            <div class="frame-bar"><span></span><span></span><span></span><em>Decision dec_8f3a1c27b9e0</em></div>
            <div class="frame-body trace">
              <div class="verdict-row"><span class="stamp-ok">Admitted</span><div><b>Lumen Family Office can subscribe to Tidewell Treasury Liquidity.</b><span class="muted small">8 checks passed. 2 rules bind.</span></div></div>
              <ol>
                <li><i class="ok"></i><span><b>Credential</b>LP-SG-0419-2207, valid to 14 Mar 2027</span></li>
                <li><i class="ok"></i><span><b>Fund policy</b>TWLF offered in Singapore as a restricted scheme</span></li>
                <li><i class="ok"></i><span><b>Residence law</b>Singapore accredited investor with opt-in, SFA s305</span><em>Binding</em></li>
                <li><i class="ok"></i><span><b>Booking licence</b>Hong Kong professional investor, Cap. 571D</span><em>Binding</em></li>
                <li><i class="ok"></i><span><b>Global screens</b>No sanctions match. Travel Rule not required.</span></li>
              </ol>
            </div>
          </div>
          <figcaption><b>Order ticket</b> A pre-trade answer with the rule that decided it. Refusals come with the fix.</figcaption>
        </figure>

        <figure class="screen">
          <div class="frame cred-frame app">
            <div class="frame-bar"><span></span><span></span><span></span><em>Credential LP-SG-0419-2207</em></div>
            <div class="frame-body stamp-on-load"><Credential inv={investors.lumen} /></div>
          </div>
          <figcaption><b>The Laissez-passer</b> One credential per investor, stamped once per jurisdiction, accepted by every issuer on the network.</figcaption>
        </figure>

        <figure class="screen">
          <div class="frame">
            <div class="frame-bar"><span></span><span></span><span></span><em>Policy change, TWLF</em></div>
            <div class="frame-body policy">
              <p class="pol-h">Remove UAE (DIFC) from the distribution list</p>
              <div class="pol-impact"><b>3 holders</b> with <b>$4.2M</b> move to redemption-only. Nobody is force-redeemed.</div>
              <table>
                <tr><td>Singapore</td><td class="r">41 holders</td><td><span class="pill-ok">Offered</span></td></tr>
                <tr><td>Hong Kong</td><td class="r">27 holders</td><td><span class="pill-ok">Offered</span></td></tr>
                <tr><td>UAE (DIFC)</td><td class="r">3 holders</td><td><span class="pill-warn">Redemption-only</span></td></tr>
              </table>
              <div class="pol-foot"><span class="muted small">Proposed by Ana Ruiz. Needs a second approver.</span><span class="btn-fake">Approve</span></div>
            </div>
          </div>
          <figcaption><b>Issuer console</b> Preview who a policy change affects before it is published. Two people on every change.</figcaption>
        </figure>

        <figure class="screen">
          <div class="frame">
            <div class="frame-bar"><span></span><span></span><span></span><em>Settlement stl_4WN8PQ2KD7ZT</em></div>
            <div class="frame-body settle">
              <ol>
                <li class="done"><b>Decision re-checked</b><span>ALLOW, 0.4 s before execution</span></li>
                <li class="done"><b>Cash leg locked</b><span>2,000,000 USDC in escrow</span></li>
                <li class="done"><b>Registry confirmed</b><span>ONCHAINID claim accepted for 0x7a3f…c21e</span></li>
                <li class="done"><b>Atomic swap</b><span>2,000,000 TWLF to investor, USDC to fund</span></li>
                <li class="now"><b>Anchored on Base Sepolia</b><span>tx 0x91be…04d7, 2 confirmations</span></li>
              </ol>
              <div class="settle-foot"><span class="pill-ok">Settled</span><span class="muted small">Receipt signed Ed25519. Only the hash is on-chain.</span></div>
            </div>
          </div>
          <figcaption><b>Settlement</b> Delivery versus payment on the issuer's chain, with the signed receipt an auditor can verify years later.</figcaption>
        </figure>
      </div>
      <div class="screens-cta"><a class="btn primary" href={url('app/')}>Try the sandbox</a><a class="arrow-link" href={url('product/')}>How the product works</a></div>
    </div>
  </section>

  <section class="band light" id="live">
    <div class="wrap">
      <div class="sec-head">
        <h2>What is live today.</h2>
        <p class="lede">Everything below is built and tested. The sandbox shows most of it; the last three apply to production organizations. Nothing on this list is a mock-up.</p>
      </div>
      <div class="cols-3 live-grid">
        <div class="item"><h4>Credential network</h4><p>Distributors share credentials with each other, with the investor's consent, so a client verified by one bank can buy through another without a second onboarding.</p></div>
        <div class="item"><h4>Investor portal</h4><p>A white-label page where an investor sees their credential, reads fund documents, acknowledges them and submits subscription requests. The distributor's brand, Laissez underneath.</p></div>
        <div class="item"><h4>Travel Rule</h4><p>IVMS101 originator and beneficiary data exchanged over TRP for transfers of 1,000 or more. A transfer waits for the beneficiary VASP before it can settle.</p></div>
        <div class="item"><h4>On-chain settlement</h4><p>ERC-3643 token and settlement contracts on the Base Sepolia testnet, with reconciliation against the register. The testnet deployment is pending; simulated settlement runs everywhere today.</p></div>
        <div class="item"><h4>Rule packs for {packCount} jurisdictions</h4><p>From Singapore to the United States and India, each pack versioned, dated and covered by regression cases. Plus global packs for sanctions and the Travel Rule.</p></div>
        <div class="item"><h4>SDKs, status and metrics</h4><p>TypeScript and Python clients, an OpenAPI 3.1 document, a public status page with 90 days of uptime, and product metrics read live from the API.</p></div>
        <div class="item"><h4>Accounts a bank can approve</h4><p>Passkeys or single sign-on, a confirmed email, recovery with a waiting period, an authenticator app, and an organization policy for session length, networks and allowed domains. A person reviews each organization before it can settle. <a class="text-link" href={url('product/#accounts')}>How accounts work</a></p></div>
        <div class="item"><h4>Contracts and billing</h4><p>An order form accepted electronically, usage metered from settled value, numbered invoices with a PDF, and reminders before anything is switched off. <a class="text-link" href={url('pricing/#billing')}>How a bill is made</a></p></div>
        <div class="item"><h4>Vendor review pack</h4><p>Sub-processors, a draft data processing agreement, privacy and terms, and a control-by-control list of what is done and what is not yet against SOC 2. <a class="text-link" href={url('trust/')}>Trust and security</a></p></div>
      </div>
    </div>
  </section>

  <section class="band" id="coverage">
    <div class="wrap">
      <div class="sec-head">
        <h2>{packCount} jurisdictions, written down to the threshold.</h2>
        <p class="lede">Each rule pack is machine-readable, versioned and dated. Counsel sign-off on the launch packs is a condition of production access and is in progress.</p>
      </div>
      <div class="table-wrap">
        <table class="grid cover">
          <thead><tr><th>Jurisdiction</th><th>What the pack resolves</th><th>Version</th><th>Status</th></tr></thead>
          <tbody>
            {packs.map((r) => <tr><td class="j">{jurName[r.jur] ?? r.jur}</td><td class="muted">{r.summary}</td><td class="ref">{r.version}</td><td><span class="status ok">Active</span></td></tr>)}
            {drafts.map((r) => <tr><td class="j">{jurName[r.jurisdiction] ?? r.jurisdiction}</td><td class="muted">{r.summary}</td><td class="ref">{r.version}</td><td><span class="status warn">Draft</span></td></tr>)}
            {globalPacks.map((r) => <tr><td class="j">Global</td><td class="muted">{r.summary}</td><td class="ref">{r.version}</td><td><span class="status ok">Active</span></td></tr>)}
          </tbody>
        </table>
      </div>
      <p class="fine cov-note">Summaries abbreviate the cited rules; full text and conditions apply. Every citation is on the <a class="text-link" href={url('sources/')}>sources page</a>.</p>
    </div>
  </section>

  <section class="band light" id="gap">
    <div class="wrap gap">
      <div>
        <h2>Tokenizing a fund is solved. Selling it across borders still takes a legal review in every country.</h2>
        <p class="lede">The numbers below are why Laissez exists. Each one is sourced and dated.</p>
      </div>
      <div class="facts">
        <div class="fact"><span class="fig">$14.69B</span><p>sits in 108 tokenized U.S. Treasury funds, up from $0.85B at the end of 2023.<Cite id={['rwa-treasuries', 'coingecko-2023']} /></p></div>
        <div class="fact"><span class="fig">104</span><p>holders own BlackRock's $2.25B BUIDL fund. Issuance scaled. Reach did not.<Cite id="rwa-buidl" /></p></div>
        <div class="fact"><span class="fig">48%</span><p>of what EU fund investors pay goes to distribution, not management.<Cite id="esma-costs" /></p></div>
        <div class="fact"><span class="fig">143,617</span><p>separate registrations keep 14,769 funds sellable across borders today.<Cite id="pwc-gfd" /></p></div>
      </div>
    </div>
  </section>

  <section class="band" id="who">
    <div class="wrap">
      <div class="sec-head"><h2>Built for the two sides of every fund sale.</h2></div>
      <div class="split">
        <a class="side" href={url('solutions/distributors/')}>
          <span class="side-k">For distributors</span>
          <h3>Offer every tokenized fund your clients qualify for, in every booking centre.</h3>
          <ul><li>Onboard a client once, use the credential with every issuer</li><li>Pre-trade answers in the order ticket, with the reason and the fix</li><li>One integration instead of one per issuer, per chain</li></ul>
          <span class="arrow-link">Distributor solutions</span>
        </a>
        <a class="side" href={url('solutions/issuers/')}>
          <span class="side-k">For issuers</span>
          <h3>Reach verified investors across borders without rebuilding onboarding.</h3>
          <ul><li>Accept Laissez as a trusted claim issuer in your existing registry</li><li>Preview who a policy change affects before you publish it</li><li>Keep your token standard, transfer agent and chain</li></ul>
          <span class="arrow-link">Issuer solutions</span>
        </a>
      </div>
    </div>
  </section>

  <section class="band light" id="commitments">
    <div class="wrap">
      <div class="sec-head"><h2>Four rules Laissez holds itself to.</h2></div>
      <div class="cols-4">
        <div class="item"><h4>Redemption is always open</h4><p>An investor whose status lapses can always exit. They cannot add or receive more. Nobody is trapped by a rule change.</p></div>
        <div class="item"><h4>No personal data on-chain</h4><p>Identity stays with the distributor that verified it. The chain sees an outcome, a hash and rule versions.</p></div>
        <div class="item"><h4>Counsel signs every rule</h4><p>Software drafts rule changes from regulator publications. A lawyer approves each one before it can bind an order.</p></div>
        <div class="item"><h4>Fail closed on the way in</h4><p>If a check cannot complete, the subscription or inbound transfer does not settle. Exits are never blocked by an outage.</p></div>
      </div>
    </div>
  </section>

  <section class="band cta-band">
    <div class="wrap cta">
      <h2>Open a sandbox. Settle a cross-border order in ten minutes.</h2>
      <p class="lede">A private copy of Laissez with fictional clients, funds and teammates. Then bring one fund and one corridor, and we will take it live with you.</p>
      <div class="hero-cta"><a class="btn primary" href={url('app/')}>Try the sandbox</a><a class="arrow-link" href={url('access/')}>Request production access</a></div>
    </div>
  </section>
</Layout>

<script>
  const grid = document.getElementById('proof-grid');
  const note = document.getElementById('proof-note');
  const fmtDur = (s: number) => (s < 90 ? `${Math.round(s)} s` : s < 5400 ? `${Math.round(s / 60)} min` : `${(s / 3600).toFixed(1)} h`);
  if (grid && note) {
    const set = (k: string, v: string) => { const el = grid.querySelector<HTMLElement>(`[data-k="${k}"]`); if (el) el.textContent = v; };
    const fallback = () => {
      set('settlements', 'Live'); set('guardrail', '0'); set('ttv', 'Minutes'); set('reuse', 'Live');
      note.textContent = 'Live figures could not be loaded right now. The metrics page reads the same endpoint and explains each definition.';
    };
    const ctl = new AbortController();
    const t = setTimeout(() => ctl.abort(), 6000);
    fetch(`${grid.dataset.api}/v1/metrics/public`, { signal: ctl.signal }).then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status))))).then((d) => {
      clearTimeout(t);
      const by = (d.north_star?.by_currency ?? []) as { currency: string; all_time: number; settlements_all_time: number }[];
      const n = by.reduce((s, x) => s + (x.settlements_all_time ?? 0), 0);
      set('settlements', n.toLocaleString('en-US'));
      const g = d.guardrail?.settled_without_allow;
      set('guardrail', g == null ? '0' : String(g));
      const ms = d.time_to_first_settlement?.median_seconds;
      set('ttv', ms == null ? 'None yet' : fmtDur(ms));
      const r = d.credential_reuse;
      set('reuse', r?.multi_fund_rate == null ? (r?.investors_with_allowed_orders ? '0%' : 'None yet') : `${Math.round(r.multi_fund_rate * 100)}%`);
      const when = d.generated_at ? new Date(d.generated_at) : new Date();
      note.textContent = `Read at ${when.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}, aggregated across every live sandbox, including Laissez's own test runs. Fictional money, not customer volume. Sandboxes are deleted after 7 days.`;
    }).catch(() => { clearTimeout(t); fallback(); });
  }
</script>

<style>
  .hero { position: relative; padding-top: clamp(2.5rem, 6vw, 5rem); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2.5rem; align-items: center; }
  .hero .display { max-width: 12ch; }
  .hero .lede { margin-top: 1.4rem; }
  .hero-cta { display: flex; gap: 1.25rem; flex-wrap: wrap; margin-top: 2rem; align-items: center; }
  .hero-fine { margin-top: 1rem; }
  .hero-map { position: relative; margin-right: calc(-1 * var(--gutter)); }
  .hero-map :global(svg) { -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 12%); mask-image: linear-gradient(90deg, transparent 0%, #000 12%); }
  @media (max-width: 1000px) { .hero-grid { grid-template-columns: 1fr; } .hero-map { margin: 1.5rem 0 0; } .hero-map :global(svg) { mask-image: none; -webkit-mask-image: none; } }
  .standards { display: flex; align-items: flex-start; gap: 1rem 2.5rem; flex-wrap: wrap; padding: 1.75rem 0 2.5rem; border-top: 1px solid var(--line); margin-top: clamp(2.5rem, 5vw, 4rem); color: var(--ink-3); font-size: 0.875rem; }
  .standards > span { padding-top: 0.1rem; white-space: nowrap; }
  .standards ul { display: grid; grid-template-columns: repeat(6, auto); gap: 0.75rem 2rem; list-style: none; margin: 0; padding: 0; flex: 1; }
  .standards li { display: grid; gap: 0.1rem; }
  .standards li b { color: var(--ink); font-weight: 600; font-size: 0.9rem; }
  .standards li span { color: var(--ink-3); font-size: 0.8rem; }
  @media (max-width: 1000px) { .standards ul { grid-template-columns: repeat(3, auto); } }
  @media (max-width: 720px) { .standards { display: grid; gap: 1rem; } .standards ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 1.25rem; } .standards li b { overflow-wrap: anywhere; } }

  .three { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); }
  .three li { border-top: 1px solid var(--line-2); padding-top: 1.25rem; display: grid; gap: 0.6rem; align-content: start; }
  .three .n { font-family: var(--f-display); font-size: 1.5rem; color: var(--green); line-height: 1; }
  .three p { margin: 0; color: var(--ink-2); line-height: 1.6; }
  .three code { font-size: 0.82rem; color: var(--ink); background: var(--white); border: 1px solid var(--line); border-radius: 6px; padding: 0.3rem 0.5rem; justify-self: start; margin-top: 0.25rem; }
  @media (max-width: 900px) { .three { grid-template-columns: 1fr; } }

  .reuse-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 3vw, 3rem); }
  .reuse-grid p { margin: 0; color: var(--ink-2); line-height: 1.6; border-top: 1px solid var(--line-2); padding-top: 1.25rem; font-size: 1.02rem; }
  .reuse-grid p::first-line { color: var(--ink); }
  .reuse-cta { margin-top: 2rem; }
  @media (max-width: 900px) { .reuse-grid { grid-template-columns: 1fr; gap: 1.25rem; } }

  .proof-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem 2rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .proof-head h2 { font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.9rem); }
  .proof-head p { margin: 0; font-size: 0.95rem; }
  .proof-head code { color: var(--ink); font-size: 0.85em; }
  .proof-grid { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--line-2); }
  .proof-grid > div { padding: 1.5rem 1.5rem 1.5rem 0; border-bottom: 1px solid var(--line); min-width: 0; }

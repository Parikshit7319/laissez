---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import { OPENAPI } from '../../api/src/openapi';

const API = import.meta.env.PUBLIC_API_BASE?.replace(/\/$/, '') || 'https://laissez-api.laissez.workers.dev';
const opCount = Object.values(OPENAPI.paths as Record<string, Record<string, unknown>>).reduce((n, item) => n + Object.keys(item).filter((k) => k !== 'parameters').length, 0);
const events = Object.entries(OPENAPI.webhooks as Record<string, { post: { description: string } }>).map(([name, w]) => [name, w.post.description] as const);
const tags = (OPENAPI.tags as { name: string; description: string }[]);

const scopes = [
  ['read', 'Read everything in the organization, including the audit export'],
  ['orders', 'Create decisions and settlements'],
  ['clients', 'Manage clients, credentials and credential shares'],
  ['funds', 'Manage funds, NAV, documents and policy proposals'],
  ['compliance', 'Screening dispositions, monitoring runs and work items'],
  ['developer', 'Webhook endpoints and delivery replay'],
  ['admin', 'Create, rotate and revoke API keys'],
];
const roles = [
  ['admin', 'Everything, including members and single sign-on'],
  ['ops', 'Read, clients, orders, work items'],
  ['compliance', 'Read, clients, compliance decisions, policy approval, work items, audit export'],
  ['issuer', 'Read, funds, policy approval'],
  ['developer', 'Read, webhooks, API keys'],
  ['auditor', 'Read and audit export only'],
];
const versions = [
  ['2026-10-02', 'Current', 'Accounts, organizations and roles. Scoped keys with IP allowlists and rotation. Idempotency-Key on every write. On-chain settlement: POST /v1/settlements may return 202 pending. Decisions record a replayable snapshot, a dealing date and the acting person or key.'],
  ['2026-10-01', 'Legacy', 'Launch API. Settlement is simulated and always returns 201 settled.'],
];
const errors = [
  ['400', 'invalid_request', 'A field failed validation. detail lists each field and what is wrong.'],
  ['400', 'unsupported_version', 'Laissez-Version names a version that does not exist.'],
  ['400', 'invalid_idempotency_key', 'Idempotency-Key must be 1 to 255 characters.'],
  ['401', 'unauthorized', 'Missing, expired, revoked or malformed token. Sessions also expire after 12 hours of inactivity.'],
  ['403', 'insufficient_scope', 'The API key does not carry the scope this operation needs.'],
  ['403', 'human_required', 'Only a signed-in person can do this. API keys can propose, not approve.'],
  ['403', 'forbidden', 'The person\'s role does not allow it.'],
  ['403', 'ip_not_allowed', 'The request came from outside the key\'s IP allowlist.'],
  ['404', 'not_found', 'No such route or resource in this organization.'],
  ['409', 'idempotency_in_progress', 'The same key is still being processed. Retry in a few seconds.'],
  ['409', 'travel_rule_pending', 'A transfer of 1,000 or more is waiting for the beneficiary VASP.'],
  ['422', 'idempotency_mismatch', 'The key was already used with a different body.'],
  ['422', 'threshold_not_met', 'A classification fails its legal test. Nothing was issued.'],
  ['429', 'rate_limited', 'Over the per-key or per-session limit. Back off and retry.'],
  ['500', 'internal_error', 'Our fault. The request was not applied.'],
];
---
<Layout title="Developers" description="The Laissez API: scoped keys, versioned endpoints, idempotent writes, signed webhooks, an OpenAPI reference and SDKs for TypeScript and Python." path="developers/">
  <section class="page-hero">
    <div class="wrap">
      <h1>Compliance as one API call before every order.</h1>
      <p class="lede">REST with JSON over HTTPS. {opCount} operations across {tags.length} resource groups, signed decision receipts, signed webhooks, a hash-chained audit log. The sandbox is live at <code class="base">{API}</code> and needs no account.</p>
      <div class="hero-cta">
        <a class="btn primary" href={url('app/')}>Try the sandbox</a>
        <a class="btn" href="#quickstart">Quickstart</a>
        <a class="btn" href={url('developers/reference/')}>API reference</a>
        <a class="btn" href={url('developers/sdks/')}>SDKs</a>
      </div>
    </div>
  </section>

  <section class="band" id="quickstart">
    <div class="wrap">
      <div class="sec-head"><h2>Sandbox to settled order in three calls.</h2><p class="lede">Every sandbox is a 7-day organization seeded with fictional investors across six jurisdictions, two funds and teammates for two-person approvals. Ten per hour per network.</p></div>
      <ol class="steps qs">
        <li><div><h4>Open a sandbox</h4><p>Returns a test API key with every scope and a session token. Both are shown once.</p>
<pre class="codeblock"><code><span class="c"># no auth</span>
curl -X POST {API}/v1/sandboxes \
  -H <span class="s">'Content-Type: application/json'</span> \
  -d <span class="s">'&#123;"name": "Aster &amp; Vale sandbox"&#125;'</span>

<span class="c"># 201</span>
&#123; <span class="k">"workspace"</span>: &#123; <span class="k">"id"</span>: <span class="s">"5f0c2a91-…"</span>, <span class="k">"kind"</span>: <span class="s">"sandbox"</span>, <span class="k">"expires_at"</span>: <span class="s">"2026-10-09T06:20:00Z"</span> &#125;,
  <span class="k">"api_key"</span>: <span class="s">"lz_test_Xq7a…"</span>, <span class="k">"session_token"</span>: <span class="s">"lz_sess_…"</span> &#125;</code></pre></div></li>
        <li><div><h4>Ask for a decision</h4><p>Evaluates the credential, fund policy, residence law, booking-centre licence, documents, fund terms and global screens. Allowed decisions carry a signed receipt and a 15 minute settle-by time.</p>
<pre class="codeblock"><code>curl -X POST {API}/v1/decisions \
  -H <span class="s">'Authorization: Bearer lz_test_Xq7a…'</span> \
  -H <span class="s">'Laissez-Version: 2026-10-02'</span> \
  -H <span class="s">'Idempotency-Key: order-2026-10-02-0001'</span> \
  -H <span class="s">'Content-Type: application/json'</span> \
  -d <span class="s">'&#123;"action": "subscribe", "investor_id": "lumen", "fund": "TWLF", "amount": 250000, "settle_with": "USDC"&#125;'</span>

<span class="c"># 201</span>
&#123; <span class="k">"id"</span>: <span class="s">"dec_8KQ2M4ZP7WXA"</span>, <span class="k">"outcome"</span>: <span class="s">"ALLOW"</span>,
  <span class="k">"headline"</span>: <span class="s">"Lumen Family Office can subscribe to Tidewell Treasury Liquidity."</span>,
  <span class="k">"checks"</span>: [ &#123; <span class="k">"layer"</span>: <span class="s">"Residence law"</span>, <span class="k">"label"</span>: <span class="s">"Singapore: Accredited investor with opt-in"</span>, <span class="k">"result"</span>: <span class="s">"pass"</span>, <span class="k">"ruleRef"</span>: <span class="s">"SFA s305, s4A"</span> &#125;, … ],
  <span class="k">"binding_rules"</span>: [ … ], <span class="k">"remedies"</span>: [], <span class="k">"rule_packs"</span>: [<span class="s">"fund/TWLF@v1"</span>, <span class="s">"SG/eligibility@2026.09.0"</span>, …],
  <span class="k">"inputs_sha256"</span>: <span class="s">"9b2f6c1e…"</span>, <span class="k">"settle_by"</span>: <span class="s">"2026-10-02T06:37:07Z"</span>, <span class="k">"receipt"</span>: &#123; … &#125;, <span class="k">"signature"</span>: <span class="s">"kW3p9y…"</span> &#125;</code></pre></div></li>
        <li><div><h4>Settle</h4><p>Re-checks current state, then moves cash and units in one transaction. Simulated settlement returns 201 settled. On-chain settlement returns 202 pending: poll the settlement or wait for <code>settlement.completed</code>.</p>
<pre class="codeblock"><code>curl -X POST {API}/v1/settlements \
  -H <span class="s">'Authorization: Bearer lz_test_Xq7a…'</span> -H <span class="s">'Idempotency-Key: order-2026-10-02-0001-settle'</span> \
  -H <span class="s">'Content-Type: application/json'</span> -d <span class="s">'&#123;"decision_id": "dec_8KQ2M4ZP7WXA"&#125;'</span>

<span class="c"># 201</span>
&#123; <span class="k">"id"</span>: <span class="s">"stl_4WN8PQ2KD7ZT"</span>, <span class="k">"status"</span>: <span class="s">"settled"</span>, <span class="k">"units"</span>: 250000, <span class="k">"simulated"</span>: true,
  <span class="k">"steps"</span>: [<span class="s">"decision_signed"</span>, <span class="s">"cash_locked"</span>, <span class="s">"registry_confirmed"</span>, <span class="s">"atomic_swap"</span>, <span class="s">"final"</span>] &#125;</code></pre></div></li>
      </ol>
      <p class="fine">A refusal looks the same, with <code>outcome: "DENY"</code> and <code>remedies</code> such as "Ask the issuer to add UAE (DIFC) to the distribution list." Redemptions skip eligibility and are only ever stopped by sanctions. Pass <code>persist: false</code> for a dry run that records nothing.</p>
    </div>
  </section>

  <section class="band light" id="authentication">
    <div class="wrap">
      <div class="sec-head"><h2>Two kinds of bearer token.</h2><p class="lede">Send <code>Authorization: Bearer &lt;token&gt;</code>. A person's session acts with their role. An API key acts with its scopes. Some actions are reserved for people.</p></div>
      <div class="cols-2">
        <div class="item"><span class="k">Sessions</span><h4><code>lz_sess_</code> from passkeys or single sign-on</h4><p>Issued by <code>POST /v1/auth/login/verify</code> or <code>POST /v1/auth/sso/exchange</code>. Valid for 7 days, or 12 hours of inactivity outside sandboxes. Sessions carry the person's role and are the only credential for human-only actions: approving or rejecting a policy change, managing members and SSO. 600 requests per minute.</p></div>
        <div class="item"><span class="k">API keys</span><h4><code>lz_test_</code> with explicit scopes</h4><p>Created by <code>POST /v1/api-keys</code> with a name, scopes, an optional IP allowlist (IPv4, IPv6 or CIDR) and an optional expiry. The key is shown once. Up to 10 active keys per organization. A key can only mint keys with scopes it has itself. 300 requests per minute.</p></div>
        <div class="item"><span class="k">Rotation</span><h4>24 hours of overlap, no downtime</h4><p><code>POST /v1/api-keys/&#123;id&#125;/rotate</code> issues a replacement with the same scopes and allowlist. The old key keeps working for 24 hours so you can roll secrets across a fleet. <code>DELETE</code> revokes immediately. A key cannot revoke itself.</p></div>
        <div class="item"><span class="k">Human-only</span><h4>Keys propose, people approve</h4><p>An API key calling <code>POST /v1/policy-changes/&#123;id&#125;/approve</code> gets <code>403 human_required</code>. The proposer can never approve their own change. Every operation in the reference states its permission, the key scopes that grant it and the roles that hold it.</p></div>
      </div>
      <div class="cols-2" style="margin-top:3.5rem">
        <div class="table-wrap"><table class="grid"><thead><tr><th>Key scope</th><th>Grants</th></tr></thead><tbody>{scopes.map(([s, d]) => <tr><td><code>{s}</code></td><td>{d}</td></tr>)}</tbody></table></div>
        <div class="table-wrap"><table class="grid"><thead><tr><th>Role</th><th>Can</th></tr></thead><tbody>{roles.map(([r, d]) => <tr><td><code>{r}</code></td><td>{d}</td></tr>)}</tbody></table></div>
      </div>
    </div>
  </section>

  <section class="band" id="conventions">
    <div class="wrap">
      <div class="sec-head"><h2>Versioned, idempotent, predictable.</h2></div>
      <div class="cols-2">
        <div id="versioning">
          <h3>Versioning</h3>
          <p class="muted">Pin a version with the <code>Laissez-Version</code> header. Leave it out to get the latest. Unknown versions return <code>400 unsupported_version</code>. Every response echoes the version used. <code>GET /v1/versions</code> lists them.</p>
          <div class="table-wrap"><table class="grid"><thead><tr><th>Version</th><th></th><th>Changes</th></tr></thead><tbody>{versions.map(([v, s, c]) => <tr><td><code>{v}</code></td><td><span class={`status ${s === 'Current' ? 'ok' : 'warn'}`}>{s}</span></td><td class="muted">{c}</td></tr>)}</tbody></table></div>
        </div>
        <div id="idempotency">
          <h3>Idempotency</h3>
          <p class="muted">Send <code>Idempotency-Key</code> (1 to 255 characters, a UUID works) on any authenticated POST, PATCH, PUT or DELETE. A retry with the same key and body within 24 hours returns the stored response with <code>Idempotent-Replayed: true</code>. The same key with a different body returns <code>422 idempotency_mismatch</code>. A retry while the first request is still running returns <code>409 idempotency_in_progress</code>.</p>
          <p class="muted">Use your order id as the key. A network timeout then costs you a retry, never a duplicate subscription. Both SDKs add a key to every write automatically.</p>
          <h3 style="margin-top:2.25rem">Limits</h3>
          <ul class="ticks">
            <li>300 requests per minute per API key, 600 per minute per session</li>
            <li>10 sandboxes per hour, 8 sign-ups per hour and 30 sign-in attempts per 10 minutes per network</li>
            <li>Up to 10 active API keys, 5 webhook endpoints per sandbox and 20 per organization</li>
            <li>Bulk eligibility: 200 rows per call. Decisions list: 200 per page. Audit log: 300 per page</li>
            <li>Over a limit: <code>429 rate_limited</code>. Back off and retry; the SDKs do this for you</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band light" id="errors">
    <div class="wrap">
      <div class="sec-head"><h2>One shape, stable codes, a sentence that says what to do.</h2>
<pre class="codeblock"><code>&#123; <span class="k">"error"</span>: &#123;
    <span class="k">"code"</span>: <span class="s">"insufficient_scope"</span>,
    <span class="k">"message"</span>: <span class="s">"This API key is not allowed to place orders or settle. Add the right scope or use another key."</span>,
    <span class="k">"detail"</span>: … <span class="c">// optional: field errors, per-class results</span>
&#125; &#125;</code></pre></div>
      <div class="table-wrap"><table class="grid err"><thead><tr><th>Status</th><th>Code</th><th>Meaning</th></tr></thead><tbody>{errors.map(([s, c, m]) => <tr><td class="num">{s}</td><td><code>{c}</code></td><td>{m}</td></tr>)}</tbody></table></div>
    </div>
  </section>

  <section class="band" id="webhooks">
    <div class="wrap">
      <div class="sec-head"><h2>Signed events for everything that changes.</h2><p class="lede">Register an HTTPS endpoint with <code>POST /v1/webhooks</code> and the event types you want, or <code>*</code>. The <code>whsec_</code> secret is returned once. Any 2xx acknowledges; Laissez tries three times, about 1 and 3 seconds apart, then records the delivery for replay.</p></div>
      <div class="cols-2">
        <div>
          <h3>Verify every delivery</h3>
          <p class="muted">The <code>Laissez-Signature</code> header is <code>t=&lt;unix seconds&gt;,v1=&lt;hex HMAC-SHA256 of "&lt;t&gt;.&lt;raw body&gt;"&gt;</code>. Sign the raw bytes, compare in constant time, reject timestamps older than five minutes. Both SDKs ship a verifier.</p>
<pre class="codeblock"><code><span class="c">// TypeScript (Node 18+, Workers, Deno, Bun)</span>
<span class="k">import</span> &#123; verifyWebhook &#125; <span class="k">from</span> <span class="s">'./laissez'</span>;

<span class="k">export default</span> &#123;
  <span class="k">async</span> fetch(req) &#123;
    <span class="k">const</span> raw = <span class="k">await</span> req.text();
    <span class="k">const</span> event = <span class="k">await</span> verifyWebhook(raw, req.headers.get(<span class="s">'laissez-signature'</span>), env.LAISSEZ_WEBHOOK_SECRET);
    <span class="k">if</span> (event.type === <span class="s">'settlement.completed'</span>) <span class="k">await</span> releaseUnits(event.data.id);
    <span class="k">return new</span> Response(<span class="s">'ok'</span>);
  &#125;
&#125;</code></pre>
<pre class="codeblock" style="margin-top:1rem"><code><span class="c"># Python (Flask)</span>
<span class="k">from</span> laissez <span class="k">import</span> verify_webhook, LaissezError

@app.post(<span class="s">"/hooks/laissez"</span>)
<span class="k">def</span> hook():
    <span class="k">try</span>:
        event = verify_webhook(request.get_data(), request.headers.get(<span class="s">"Laissez-Signature"</span>), os.environ[<span class="s">"LAISSEZ_WEBHOOK_SECRET"</span>])
    <span class="k">except</span> LaissezError <span class="k">as</span> e:
        <span class="k">return</span> e.message, 400
    <span class="k">if</span> event[<span class="s">"type"</span>] == <span class="s">"settlement.completed"</span>:
        release_units(event[<span class="s">"data"</span>][<span class="s">"id"</span>])
    <span class="k">return</span> <span class="s">"ok"</span>, 200</code></pre>
<pre class="codeblock" style="margin-top:1rem"><code><span class="c"># By hand</span>
expected = hmac.new(secret, f<span class="s">"&#123;t&#125;.&#123;raw_body&#125;"</span>.encode(), hashlib.sha256).hexdigest()
hmac.compare_digest(expected, v1) <span class="k">and</span> abs(time.time() - t) &lt;= 300</code></pre>
        </div>
        <div class="table-wrap">
          <table class="grid"><thead><tr><th>Event</th><th>When</th></tr></thead>
            <tbody>{events.map(([e, d]) => <tr><td><code class="ev">{e}</code></td><td class="muted">{d}</td></tr>)}</tbody>
          </table>
          <p class="fine" style="margin-top:1.25rem">Payload: <code>&#123; "id": "evt_…", "type", "created", "data" &#125;</code>. Each event's data schema is in the <a class="text-link" href={url('developers/reference/#tag-Webhooks')}>reference</a>. <code>POST /v1/webhooks/&#123;id&#125;/test</code> sends a signed <code>ping</code>. <code>GET /v1/webhook-deliveries</code> shows status, attempts and latency; <code>POST /v1/webhook-deliveries/&#123;id&#125;/replay</code> resends with a fresh signature.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band raised" id="next">
    <div class="wrap">
      <div class="sec-head"><h2>Reference, SDKs and status.</h2></div>
      <div class="cols-3">
        <a class="panel link" href={url('developers/reference/')}><span class="k">API reference</span><h4>Every operation, rendered from the OpenAPI document</h4><p>{opCount} operations with permissions, parameters, request fields, response codes and curl examples. The same document is served at <code>GET /v1/openapi.json</code> for code generators and API clients.</p></a>
        <a class="panel link" href={url('developers/sdks/')}><span class="k">SDKs</span><h4>TypeScript and Python, dependency-free</h4><p>Resource namespaces, automatic idempotency keys, retries with backoff on 429 and 5xx, typed errors, settlement polling and webhook verification. Tested against mocked transports.</p></a>
        <a class="panel link" href={url('status/')}><span class="k">Status</span><h4>Live component health and 90 days of uptime</h4><p>API, database, chain RPC, sanctions data freshness and holder monitoring, checked every 10 minutes. Also at <code>GET /v1/status</code>.</p></a>
      </div>
      <div class="table-wrap" style="margin-top:3.5rem">
        <table class="grid"><thead><tr><th>Resource group</th><th>Covers</th></tr></thead>
          <tbody>{tags.map((t) => <tr><td><a class="text-link" href={url(`developers/reference/#tag-${t.name.replace(/\s+/g, '-')}`)}>{t.name}</a></td><td class="muted">{t.description}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>
<style>
  .base { font-size: 0.9em; color: var(--ink); background: var(--white); border: 1px solid var(--line); border-radius: 6px; padding: 0.1rem 0.4rem; }
  .ev { color: var(--ink); font-size: 0.86rem; }
  
  .band code:not(.codeblock code) { color: var(--ink); }
  .qs li { grid-template-columns: 3rem minmax(0, 1fr); }
  .qs .codeblock { margin-top: 1rem; }
  .err td.num { font-family: var(--f-mono); font-size: 0.9rem; }
  h3 { margin-bottom: 0.9rem; }
  .panel.link { display: block; text-decoration: none; color: inherit; transition: border-color 160ms ease, transform 160ms ease; }
  .panel.link:hover { border-color: var(--green); }
  .panel.link .k { display: block; color: var(--ink-3); font-size: 0.82rem; font-weight: 500; margin-bottom: 0.75rem; }
  .panel.link h4 { margin-bottom: 0.6rem; }
  .panel.link p { color: var(--ink-2); font-size: 0.95rem; margin: 0; line-height: 1.6; }
  .sec-head .codeblock { align-self: start; }
  @media (max-width: 600px) { .qs li { grid-template-columns: 2rem minmax(0, 1fr); gap: 0.6rem; } }
</style>

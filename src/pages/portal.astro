---
import Portal from '../portal/Portal';
import { url } from '../lib/url';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Investor portal</title>
  <meta name="description" content="Your private investor portal: eligibility, fund documents and subscription requests." />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="referrer" content="no-referrer" />
  <meta name="theme-color" content="#1f3a33" />
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style is:global>
    html, body { margin: 0; background: #f5f3ee; }
  </style>
</head>
<body>
  <Portal client:only="preact" />
  <noscript><p style="font: 16px/1.5 system-ui, sans-serif; padding: 2rem;">The investor portal needs JavaScript. Turn it on and reload this page.</p></noscript>
</body>
</html>
